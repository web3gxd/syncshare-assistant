{
  "manifest_version": 3,
  "name": "SyncShare — помощник",
  "version": "1.2.3",
  "description": "Панель управления SyncShare: статистика, задержки и восстановление отметок.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SyncShare — помощник",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lms.ranepa.ru/mod/quiz/attempt.php*",
        "https://lms.ranepa.ru/mod/quiz/summary.php*"
      ],
      "js": [
        "client.js",
        "panel.js",
        "engine.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-96.png",
        "fonts/Montserrat-Variable.woff2"
      ],
      "matches": [
        "https://lms.ranepa.ru/*"
      ]
    }
  ]
}
